# ──────────────────────────────────────────────
# TruthLens AI — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# Your Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for analysis
GROQ_MODEL=llama-3.3-70b-versatile

# Secret used to sign login session tokens (demo auth).
# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never share this value.
SECRET_KEY=change-me-to-a-long-random-string

# Input length limits (characters)
MAX_INPUT_LENGTH=15000
MIN_INPUT_LENGTH=20

# Request timeout in seconds
REQUEST_TIMEOUT=60

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
