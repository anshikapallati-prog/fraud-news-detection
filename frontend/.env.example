# ──────────────────────────────────────────────
# TruthLens AI — Frontend environment variables
# Copy this file to .env.local and adjust if needed.
# ──────────────────────────────────────────────
#
# Vite only exposes variables that start with VITE_ to the browser.
# NEVER put secrets (API keys) in this file — only the backend holds the
# Groq API key. This is a public configuration value.
#
# Base URL of the TruthLens AI backend.
# Defaults to http://localhost:8000 when this file is absent.
VITE_API_URL=http://localhost:8000
